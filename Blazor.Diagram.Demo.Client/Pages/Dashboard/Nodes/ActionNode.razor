@using Blazor.Diagrams.Core.Models

<div class="group relative">
    <div class="default-node flex flex-col items-center justify-center border-1px" >
        @Node.Title
    </div>

    @foreach (var port in Node.Ports)
    {
        var portCss = port.Alignment switch
        {
            PortAlignment.Top => "-top-2 left-[calc(50%-8px)]",
            PortAlignment.Right => "right-[-16px] top-[calc(50%-8px)]",
            PortAlignment.Bottom => "-bottom-2 left-[calc(50%-8px)]",
            PortAlignment.Left => "-left-4 top-[calc(50%-8px)]",
            _ => "",
        };
        <Blazor.Diagrams.Components.Renderers.PortRenderer @key="port" Port="port" Class=@($"default-node action-port w-[16px] h-[16px] rounded-full absolute {portCss}") />
    }
</div>