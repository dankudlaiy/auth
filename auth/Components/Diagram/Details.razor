@page "/diagrams/details"
@using auth.Data
@using Blazor.Diagrams
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

<h1>Details</h1>

<div>
    <h2>Diagram</h2>
    <hr />
    @if (_diagram is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Name</dt>
            <dd class="col-sm-10">@_diagram.Name</dd>
        </dl>
        <div>
            <a href="@($"/diagrams/delete?id={_diagram.Id}")">Delete</a> |
            <a href="@("/diagrams")">Back to List</a>
        </div>
        @if (_diagramWrapperLoaded)
        {
            @* <DiagramWrapper Data=@_data/> *@
            <DiagramWrapper/>
        }
        else
        {
            <p><em>Loading...</em></p>
        }
    }
</div>

@code {
    private Diagram? _diagram;
    private string? _data;
    private bool _diagramWrapperLoaded;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        _diagram = await context.Diagrams.FirstOrDefaultAsync(m => m.Id == Id);
        //
        // if (_diagram is null)
        // {
        //     NavigationManager.NavigateTo("notfound");
        //     return;
        // }
        //
        // _data = _diagram.Data;
        //
        _diagramWrapperLoaded = true;
    }
}