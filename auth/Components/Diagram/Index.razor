@page "/diagrams"
@rendermode InteractiveServer
@using auth.Data
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@implements IAsyncDisposable
@attribute [Authorize]

<PageTitle>Index</PageTitle>

<h1>Index</h1>

<p>
    <input type="search" @bind="titleFilter" @bind:event="oninput" />
</p>

<p>
    <a href="diagrams/create">Create New</a>
</p>

<div>
    <QuickGrid Class="table" Items="FilteredDiagrams" Pagination="pagination">
        <PropertyColumn Property="diagram => diagram.Id" Sortable="true" />
        <PropertyColumn Property="diagram => diagram.Name" Title="Name" />

        <TemplateColumn Context="diagram">
            <a href="@($"diagrams/details?id={diagram.Id}")">Details</a> |
            <a href="@($"diagrams/delete?id={diagram.Id}")">Delete</a>
        </TemplateColumn>
    </QuickGrid>
</div>

<Paginator State="pagination" />


@code {
    private PaginationState pagination = new() { ItemsPerPage = 5 };
    private string titleFilter = string.Empty;
    private ApplicationDbContext context = null!;

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    private IQueryable<Diagram> FilteredDiagrams => 
        context.Diagrams.Where(m => m.Name.Contains(titleFilter));

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}