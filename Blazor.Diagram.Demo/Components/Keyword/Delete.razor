@page "/keywords/delete"
@using Blazor.Diagram.Demo.Data
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager
@attribute [Authorize(Roles = "Admin")]

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>Keyword</h2>
    <hr />
    @if (_keyword is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Name</dt>
            <dd class="col-sm-10">@_keyword.Name</dd>
        </dl>
        <EditForm method="post" Model="_keyword" OnValidSubmit="DeleteKeyword" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(_keyword is null)">Delete</button> |
            <a href="/keywords">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private Keyword? _keyword;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        _keyword = await context.Keywords.FirstOrDefaultAsync(m => m.Id == Id);

        if (_keyword is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteKeyword()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        context.Keywords.Remove(_keyword!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/keywords");
    }
}