@page "/keywords/create"
@using Blazor.Diagram.Demo.Data
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager
@attribute [Authorize(Roles = "Admin")]

<PageTitle>Create</PageTitle>

<h1>Create</h1>

<h2>Keyword</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="Keyword" OnValidSubmit="AddKeyword" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" />
            <div class="mb-3">
                <label for="title" class="form-label">Name:</label>
                <InputText id="title" @bind-Value="Keyword.Name" class="form-control" />
                <ValidationMessage For="() => Keyword.Name" class="text-danger" />
            </div>
            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/keywords">Back to List</a>
</div>


@code {
    [SupplyParameterFromForm]
    private Keyword Keyword { get; set; } = new();

    private async Task AddKeyword()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        context.Keywords.Add(Keyword);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/keywords");
    }
}