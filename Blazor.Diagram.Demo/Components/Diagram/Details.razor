@page "/diagrams/details"
@using Blazor.Diagram.Demo.Client.Models
@using Blazor.Diagram.Demo.Data
@using Blazor.Diagrams
@using Microsoft.EntityFrameworkCore
@using Blazor.Diagram.Demo.Client.Pages.Diagram
@using Microsoft.AspNetCore.Authorization
@using Blazor.Diagram.Demo.Client.Pages.Dashboard
@using Blazored.LocalStorage
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>Details</PageTitle>

<h1>Details</h1>

<div>
    <h2>Diagram</h2>
    <hr />
    @if (_diagram is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Name</dt>
            <dd class="col-sm-10">@_diagram.Name</dd>
        </dl>
        <div>
            <a href="@("/diagrams")">Back to List</a>
        </div>
        <div class="w-full h-full relative" style="height: 870px">
            <Dashboard OnLayoutSaved="@HandleLayoutSaved" Data=@_diagram.Data Title=@_diagram.Name Actions=@_actions />
        </div>
    }
</div>

@code {
    private Diagram? _diagram;
    private IEnumerable<TelephonyActionModel> _actions;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        _diagram = await context.Diagrams.FirstOrDefaultAsync(m => m.Id == Id);
        var actions = context.Actions.ToList();
        _actions = actions.Select(x => new TelephonyActionModel { Id = x.Id, Name = x.Name }).ToList();

        if (_diagram is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task HandleLayoutSaved(string data)
    {
        if (_diagram != null)
        {
            await using var context = await DbFactory.CreateDbContextAsync();
            _diagram.Data = data;
        
            context.Diagrams.Update(_diagram);
            await context.SaveChangesAsync();
        }
    }
}