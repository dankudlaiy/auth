@page "/diagrams/delete"
@using Blazor.Diagram.Demo.Data
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager
@attribute [Authorize]

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>Diagram</h2>
    <hr />
    @if (_diagram is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Name</dt>
            <dd class="col-sm-10">@_diagram.Name</dd>
        </dl>
        <EditForm method="post" Model="_diagram" OnValidSubmit="DeleteDiagram" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(_diagram is null)">Delete</button> |
            <a href="/diagrams">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private Diagram? _diagram;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        _diagram = await context.Diagrams.FirstOrDefaultAsync(m => m.Id == Id);

        if (_diagram is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteDiagram()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        context.Diagrams.Remove(_diagram!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/diagrams");
    }
}